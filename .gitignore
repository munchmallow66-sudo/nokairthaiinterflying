# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# Visual-regression captures. screenshots/before/ is committed as the baseline;
# every later phase is a local artifact — a full run is ~26MB of PNGs.
/screenshots/*
!/screenshots/before/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# Rollback snapshots written by the scripts/ data-fix jobs. They contain live
# applicant remarks copied out of the database and must not leave the machine.
/scripts/*-backup-*.json

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / OS
.DS_Store
*.pem
.vscode/
.idea/
